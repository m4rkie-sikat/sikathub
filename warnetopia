Hub.unload = function()
    Hub.alive = false
    Travel.active = false
    destroyFloat()
    pcall(dropSpeed)
    pcall(dropFly)
    pcall(function()
        RunService:Set3dRenderingEnabled(true)
    end)
    for _, c in ipairs({ heartbeat, stepped, jumpConn, idleConn, snapConn, dayConn, summaryConn }) do
        pcall(function()
            c:Disconnect()
        end)
    end
    pcall(function()
        Library:Unload()
    end)
    if getgenv().SikatHub == Hub then
        getgenv().SikatHub = nil
    end
end

